  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@mediconnect/design-system": "link:../shared/packages/design-system",
    "@playwright/test": "^1.65.1",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.4.6",
    "typescript": "^5"
  },
  "packageManager": "pnpm@12.21.0"
